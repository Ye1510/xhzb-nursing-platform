<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xhzb.nursing.mapper.ReservationMapper">

    <resultMap type="Reservation" id="ReservationResult">
        <result property="id"    column="id"    />
        <result property="name"    column="name"    />
        <result property="mobile"    column="mobile"    />
        <result property="time"    column="time"    />
        <result property="arriveTime"    column="arrive_time"    />
        <result property="visitor"    column="visitor"    />
        <result property="type"    column="type"    />
        <result property="status"    column="status"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateBy"    column="update_by"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectReservationVo">
        select id, name, mobile, time, arrive_time, visitor, type, status, create_time, update_time, create_by, update_by, remark from reservation
    </sql>

    <select id="selectReservationList" parameterType="Reservation" resultMap="ReservationResult">
        <include refid="selectReservationVo"/>
        <where>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="mobile != null  and mobile != ''"> and mobile like concat('%', #{mobile}, '%')</if>
            <if test="visitor != null  and visitor != ''"> and visitor like concat('%', #{visitor}, '%')</if>
            <if test="type != null "> and type = #{type}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="startTime != null "> and time &gt;= #{startTime}</if>
            <if test="endTime != null "> and time &lt;= #{endTime}</if>
        </where>
        order by create_time desc
    </select>

    <select id="selectReservationById" parameterType="Long" resultMap="ReservationResult">
        <include refid="selectReservationVo"/>
        where id = #{id}
    </select>

    <insert id="insertReservation" parameterType="Reservation" useGeneratedKeys="true" keyProperty="id">
        insert into reservation
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null">name,</if>
            <if test="mobile != null">mobile,</if>
            <if test="time != null">time,</if>
            <if test="arriveTime != null">arrive_time,</if>
            <if test="visitor != null">visitor,</if>
            <if test="type != null">type,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="name != null">#{name},</if>
            <if test="mobile != null">#{mobile},</if>
            <if test="time != null">#{time},</if>
            <if test="arriveTime != null">#{arriveTime},</if>
            <if test="visitor != null">#{visitor},</if>
            <if test="type != null">#{type},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateReservation" parameterType="Reservation">
        update reservation
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null">name = #{name},</if>
            <if test="mobile != null">mobile = #{mobile},</if>
            <if test="time != null">time = #{time},</if>
            <if test="arriveTime != null">arrive_time = #{arriveTime},</if>
            <if test="visitor != null">visitor = #{visitor},</if>
            <if test="type != null">type = #{type},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteReservationById" parameterType="Long">
        delete from reservation where id = #{id}
    </delete>

    <delete id="deleteReservationByIds" parameterType="String">
        delete from reservation where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 查询当天取消预约数量 -->
    <select id="countCancelled" resultType="int">
        select count(*) from reservation
        where create_by = #{userId}
          and status = 2
          and update_time &gt;= #{start}
          and update_time &lt; #{end}
    </select>

    <!-- 查询每个时间段剩余预约次数（每个时间段最大预约数为6） -->
    <select id="countByTime" resultType="java.util.Map">
        select date_format(time, '%Y-%m-%d %H:%i:%s') as time,
               (6 - count(*)) as count
        from reservation
        where time &gt;= #{start}
          and status != 2
        group by time
    </select>

    <!-- 查询当前用户的预约列表 -->
    <select id="selectReservationListByUser" resultMap="ReservationResult">
        <include refid="selectReservationVo"/>
        <where>
            and create_by = #{userId}
            <if test="reservation.name != null  and reservation.name != ''"> and name like concat('%', #{reservation.name}, '%')</if>
            <if test="reservation.mobile != null  and reservation.mobile != ''"> and mobile like concat('%', #{reservation.mobile}, '%')</if>
            <if test="reservation.visitor != null  and reservation.visitor != ''"> and visitor like concat('%', #{reservation.visitor}, '%')</if>
            <if test="reservation.type != null "> and type = #{reservation.type}</if>
            <if test="reservation.status != null "> and status = #{reservation.status}</if>
            <if test="reservation.startTime != null "> and time &gt;= #{reservation.startTime}</if>
            <if test="reservation.endTime != null "> and time &lt;= #{reservation.endTime}</if>
        </where>
        order by create_time desc
    </select>
</mapper>
