# ==============================================================================
# 星海智伴 环境变量配置示例
# ------------------------------------------------------------------------------
# 用法：
#   1. 复制本文件为 .env（或直接配置到系统环境变量中）
#   2. 按下方说明填入自己的凭证
#   3. 生产环境请使用密钥管理服务或 CI/CD 的 Secret 注入，不要提交 .env
#
#   Windows:  setx DB_PASSWORD "your-password"   (需重开终端生效)
#   Linux:    export DB_PASSWORD="your-password"
# ==============================================================================

# ---- 数据库 (MySQL 8.0) -------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=xhzb
DB_USERNAME=root
DB_PASSWORD=

# ---- 缓存 (Redis 6/7，业务缓存 + 会话 + IoT 产品缓存) --------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- 向量库 (Redis Stack，供 Spring AI RAG 使用，需单独部署) --------------------
# 拉取命令：docker run -d --name redis-stack -p 6378:6379 redis/redis-stack:latest
VECTOR_STORE_HOST=localhost
VECTOR_STORE_PORT=6378

# ---- JWT 令牌密钥 -------------------------------------------------------------
# 生成方式：openssl rand -base64 48
JWT_SECRET=

# ---- 大模型 (阿里云百炼 DashScope，OpenAI 兼容模式) ----------------------------
# 控制台：https://bailian.console.aliyun.com/  用于 AI 问答与健康评估
OPENAI_API_KEY=

# ---- 对象存储 (阿里云 OSS) -----------------------------------------------------
OSS_ENDPOINT=oss-cn-guangzhou.aliyuncs.com
OSS_BUCKET_NAME=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ---- 物联网 (华为云 IoTDA) ----------------------------------------------------
# 在 IoTDA 控制台「应用侧接入」获取；endpoint 为应用接入域名
HUAWEI_IOT_REGION=cn-north-4
HUAWEI_IOT_ENDPOINT=
HUAWEI_IOT_PROJECT_ID=
HUAWEI_CLOUD_AK=
HUAWEI_CLOUD_SK=
# AMQP 订阅设备上报数据所用
HUAWEI_IOT_ACCESS_KEY=
HUAWEI_IOT_ACCESS_CODE=

# ---- 微信小程序 ---------------------------------------------------------------
WX_MINIAPP_APPID=
WX_MINIAPP_SECRET=

# ---- 文件上传路径 (可选，默认 /home/xhzb/uploadPath) ---------------------------
# XHZB_UPLOAD_PATH=/home/xhzb/uploadPath
